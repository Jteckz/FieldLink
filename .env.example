# Copy to .env and edit. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use local SQLite; use PostgreSQL for staging/production:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/internship_platform

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
PRIVATE_MEDIA_ROOT=./private_media
CV_MAX_UPLOAD_BYTES=5242880

# Trusted (verified) orgs skip manual moderation when true. Keep false for the MVP.
AUTO_PUBLISH_VERIFIED_ORGS=false
APPLICATION_REQUIRES_CV=false
